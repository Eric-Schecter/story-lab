,"str","^继续调查","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["^ ",{"->":"investigation"},"\n",null]}],null],"read_last_note":[["#","^source: data/fragments.json","/#","#","^last_note","/#","^如果有人看到这个，别点灯。灯是我吹灭的，不是我失职，是我故意的。让它以为我们已经走了。——老林","\n","ev",true,"/ev",{"VAR=":"clue_last_note","re":true},"ev",{"VAR?":"fragments"},1,"+",{"VAR=":"fragments","re":true},"/ev","ev","str","^继续调查","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["^ ",{"->":"investigation"},"\n",null]}],null],"read_salvage":[["#","^source: data/fragments.json","/#","#","^salvage","/#","^沉船里找到半张图纸：灯罩内壁刻满细纹，旁边注着一行小字——“强光惊它，柔光引路。光要软得像月光，它才不会醒。”","\n","ev",true,"/ev",{"VAR=":"clue_salvage","re":true},"ev",{"VAR?":"fragments"},1,"+",{"VAR=":"fragments","re":true},"/ev","ev","str","^继续调查","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["^ ",{"->":"investigation"},"\n",null]}],null],"final_choice":[["^鲸落之光在你手里。你会怎么做？","\n","ev","str","^点亮探照灯","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^交给老林","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^柔光：用知识寻找第三条路","/str",{"VAR?":"fragments"},5,">=",{"VAR?":"codex_complete"},"&&","/ev",{"*":".^.c-2","flg":5},{"c-0":["^ ",{"->":"ending_light"},"\n",null],"c-1":["^ ",{"->":"ending_entrust"},"\n",null],"c-2":["^ ",{"->":"ending_gentle"},"\n","ev",{"VAR?":"fragments"},5,"<",{"VAR?":"codex_complete"},"!","||","/ev",[{"->":".^.b","c":true},{"b":["^？？？——似乎还有第三条路……（原作此选项锁定）",{"->":".^.^.^.12"},null]}],"nop","\n",null]}],null],"ending_light":["#","^source: scripts/ending_panel.gd","/#","#","^light","/#","ev","str","^light","/str","/ev",{"VAR=":"ending","re":true},"^点亮探照灯","\n","^你亲手把鲸落之光装进探照灯。","\n","^光柱刺破雾海，深海的雾开始散了。码头上的人们欢呼起来。","\n","^但海面下，有巨大的阴影翻了个身。","\n","^老林按住你的肩膀：“从今天起，守夜的人，多了一个。”","\n","^—— 主线完成。雾海散了，但深海里有什么，醒了。","\n","end",null],"ending_entrust":["#","^source: scripts/ending_panel.gd","/#","#","^entrust","/#","ev","str","^entrust","/str","/ev",{"VAR=":"ending","re":true},"^交给老林","\n","^你把鲸落之光交给了老林。","\n","^他看了很久，把它沉进了海里。“有些秘密，守比说难。”","\n","^“三年了，我一个人守。现在，有你陪我了。”","\n","^他塞给