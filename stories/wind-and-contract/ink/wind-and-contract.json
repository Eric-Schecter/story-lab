,"^暮潮港，次日清晨。","\n","^账房：“我抄过那封信。你父亲欠商会的船款还没有结清，我怕你看见它，就再也不肯签约。”","\n","^艾琳：“所以你替我选了。连小港的人也一起替他们选了。”","\n","^账房把一张盖着红印的文书放在灯下。","\n","ev",{"VAR?":"decision"},"str","^违约运粮","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^文书要求日落前交出船契：擅换货物使原有船贷提前到期。",{"->":".^.^.^.18"},null]}],"nop","\n","ev",{"VAR?":"decision"},"str","^违约运粮","/str","!=","/ev",[{"->":".^.b","c":true},{"b":["^文书要求日落前重新核验船契：染料货款虽已结清，旧船贷却被另行列入担保审查。",{"->":".^.^.^.28"},null]}],"nop","\n","^账房：“交六百金币作暂缓保证金，能换七天。钱会被冻结，七天后仍须解决旧债。否则，船就不能离港。”","\n","^大副：“货款是货款，船贷是船贷。可为什么偏偏今天查？”","\n","^艾琳看着文书上的日期。签发于三天前，早于她决定航向的那一夜。","\n","^艾琳：“他们不是在等我犯错。他们是在等我回来。”","\n",{"->":"ch1_investigate"},null],"ch1_investigate":[["^码头的铁链还没有锁上。离日落，只剩一轮潮水。","\n","ev","str","^核对账册与追索令的日期。","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^去小港的粮商那里打听货源。","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^先和船员谈谈欠款与去留。","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^召集大家，决定保船的办法。","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["\n",{"->":"ch1_ledger"},null],"c-1":["\n",{"->":"ch1_supplier"},null],"c-2":["\n",{"->":"ch1_crew"},null],"c-3":["\n",{"->":"ch1_decide"},null]}],null],"ch1_ledger":["ev",true,"/ev",{"VAR=":"evidence","re":true},"^账册记着父亲最后一次还款，收款栏有商会的骑缝章；追索令却没有扣掉这一笔。","\n","^艾琳：“这里少算了四百。不是小数。”","\n","^账房：“原始收据在商会库房。只有这页抄账，他们会说是我写错。”","\n","^艾琳：“那就让他们当着港务官的面说。”","\n","^她将这页抄账封好。它足以要求复核，还不足以证明整笔债务已经清偿。","\n",{"->":"ch1_investigate"},null],"ch1_supplier":["^粮商在空货架上摊开一张粗盐订单。北面的灰礁港缺盐，却不在商会独家货单之内。","\n","^粮商：“运一趟，扣掉进货和港费，净赚三百。但盐场只收现款，要先压一百。”","\n","ev",{"VAR?":"port_relation"},0,">","/ev",[{"->":".^.b","c":true},{"b":["^粮商：“小港记得你送来的粮。我可以替你向港务所具保，换一次出港机会。”",{"->":".^.^.^.10"},null]}],"nop","\n","ev",{"VAR?":"port_relation"},0,"<=","/ev",[{"->":".^.b","c":true},{"b":["^粮商：“小港卖船买粮的那天，你的染料船驶过去了。现在叫我替你担保，我做不到。”",{"->":".^.^.^.18"},null]}],"nop","\n","^艾琳：“这张订单还有效吗？”","\n","^粮商：“到今晚。过了潮水，买家会找别的船。”","\n",{"->":"ch1_investigate"},null],"ch1_crew":["ev",{"VAR?":"crew_debt"},0,">","/ev",[{"->":".^.b","c":true},{"b":["^船员们的两百金币还在账上。大副把借据放到桌面，没有催她，也没有收回。",{"->":".^.^.^.6"},null]}],"nop","\n","ev",{"VAR?":"crew_debt"},0,"==","/ev",[{"->":".^.b","c":true},{"b":["^船员们把下一趟航程的口粮摆在桌上，等她说船还能不能开。",{"->":".^.^.^.14"},null]}],"nop","\n","^大副：“我们可以陪你冒险。但谁的钱会被押住，谁会被留在港里，先说清楚。”","\n","ev",{"VAR?":"crew_debt"},0,">","/ev",[{"->":".^.b","c":true},{"b":["^艾琳：“我记得欠款。它不会因为船遇到麻烦就消失。”",{"->":".^.^.^.24"},null]}],"nop","\n","^大副：“还有账房。有人想把他赶下船。”","\n","^艾琳：“他要把知道的说完。信任能不能回来，是另一回事。”","\n",{"->":"ch1_investigate"},null],"ch1_decide":[["^可用金币：","ev",{"VAR?":"money"},"out","/ev","^。欠船员：","ev",{"VAR?":"crew_debt"},"out","/ev","^。","\n","^交保证金需要六百；小港具保运盐需要一百现款和小港信任；申请账目复核需要那页还款记录。","\n","ev",{"VAR?":"money"},600,"<","/ev",[{"->":".^.b","c":true},{"b":["^目前付不起保证金。",{"->":".^.^.^.20"},null]}],"nop","\n","ev",{"VAR?":"port_relation"},0,"<=","/ev",[{"->":".^.b","c":true},{"b":["^小港目前不愿替你具保。",{"->":".^.^.^.28"},null]}],"nop","\n","ev",{"VAR?":"evidence"},"!","/ev",[{"->":".^.b","c":true},{"b":["^尚未核对还款记录，可以返回调查。",{"->":".^.^.^.35"},null]}],"nop","\n","ev","str","^再查一查。","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^交六百保证金，换七天时间。","/str",{"VAR?":"money"},600,">=","/ev",{"*":".^.c-1","flg":21},"ev","str","^接受小港具保，押一百金币运盐。","/str",{"VAR?":"port_relation"},0,">",{"VAR?":"money"},100,">=","&&","/ev",{"*":".^.c-2","flg":21},"ev","str","^提交还款记录，请港务官复核。","/str",{"VAR?":"evidence"},"/ev",{"*":".^.c-3","flg":21},{"c-0":["\n",{"->":"ch1_investigate"},null],"c-1":["\n","ev",{"VAR?":"money"},600,"-",{"VAR=":"money","re":true},"/ev","ev","str","^保证金暂缓","/str","/ev",{"VAR=":"chapter_one_route","re":true},"^六百金币被封入港务所的专用钱箱。收据写着“冻结”，不是“清偿”。","\n","ev",{"VAR?":"crew_debt"},0,">","/ev",[{"->":".^.b","c":true},{"b":["^船员的两百欠款仍未偿还。大副在借据背面又添了一行日期。",{"->":".^.^.^.21"},null]}],"nop","\n","^大副：“七天后呢？”","\n","^艾琳：“去灰礁港。我们需要商会之外的买家，也需要那张原始收据。”","\n",{"->":"ch1_depart"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"money"},100,"-",{"VAR=":"money","re":true},"/ev","ev","str","^小港具保","/str","/ev",{"VAR=":"chapter_one_route","re":true},"^粮商签下担保。若艾琳不回来，商会可以追偿他名下的仓库。","\n","^艾琳：“你知道自己押上的是什么吗？”","\n","^粮商：“知道。所以你要回来。别只寄一封道歉的信。”","\n","^一百金币付给盐场，货还在岸上；三百净收益，要等灰礁港交货后才能兑现。","\n",{"->":"ch1_depart"},{"#f":5}],"c-3":["\n","ev",{"VAR?":"guild_relation"},1,"-",{"VAR=":"guild_relation","re":true},"/ev","ev","str","^公开复核","/str","/ev",{"VAR=":"chapter_one_route","re":true},"^港务官比对日期，准许一次往返航行，命商会在七日内提交原始收据。船契仍由港务所保管。","\n","^商会代表：“抄账可以伪造。你要为这项指控负责。”","\n","^艾琳：“我没有说债都还清了。我只要求，你们把收过的钱算进去。”","\n","^账房按下手印。他的证词也会被查验，再没有退回沉默的余地。","\n",{"->":"ch1_depart"},{"#f":5}]}],null],"ch1_depart":["^铁链被收回岸上。艾琳带着七日的期限走上甲板。","\n","^大副：“有人看见账房昨晚去过商会。”","\n","^账房：“我去取原始收据。他们说，收据已经送到灰礁港的分会了。”","\n","^艾琳：“从现在起，你写的每笔账都交给大副核对。到了灰礁港，你跟我一起去取。”","\n","^账房点头，却不敢看船尾。","\n","^那里停着一艘没有升旗的快船。艾琳的船离开泊位时，它也松开了缆绳。","\n",{"->":"ch1_close"},null],"ch1_close":["^第一章结算：","ev",{"VAR?":"chapter_one_route"},"out","/ev","^。","\n","^可用金币：","ev",{"VAR?":"money"},"out","/ev","^。欠船员：","ev",{"VAR?":"crew_debt"},"out","/ev","^。","\n","ev",{"VAR?":"chapter_one_route"},"str","^保证金暂缓","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^另有六百金币被冻结，尚未退回。",{"->":".^.^.^.27"},null]}],"nop","\n","ev",{"VAR?":"chapter_one_route"},"str","^小港具保","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^一百金币已作盐货预付款；订单尚未交付，收益未结算。",{"->":".^.^.^.37"},null]}],"nop","\n","^下一站：灰礁港。期限：七日。","\n","^——第一章结束：追索令——","\n","^下一章预告：没有标价的航线。","\n","end",null],"global decl":["ev",300,{"VAR=":"money"},0,{"VAR=":"guild_relation"},0,{"VAR=":"port_relation"},"str","^尚未选择","/str",{"VAR=":"decision"},0,{"VAR=":"crew_debt"},false,{"VAR=":"evidence"},"str","^尚未选择","/str",{"VAR=":"chapter_one_route"},"/ev","end",null]}],"listDefs":{}}